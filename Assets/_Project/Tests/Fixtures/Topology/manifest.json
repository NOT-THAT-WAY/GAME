      "file": "invalid-broken-pivot-reference.json",
      "expectedIssueCodes": ["pivot_reference_missing"]
    },
    {
      "id": "edge-out-of-bounds",
      "file": "invalid-edge-out-of-bounds.json",
      "expectedIssueCodes": ["edge_out_of_bounds"]
    },
    {
      "id": "spawn-out-of-bounds",
      "file": "invalid-spawn-out-of-bounds.json",
      "expectedIssueCodes": ["spawn_out_of_bounds"]
    },
    {
      "id": "duplicate-json-property",
      "file": "invalid-duplicate-json-property.json",
      "expectedIssueCodes": ["json_property_duplicate"]

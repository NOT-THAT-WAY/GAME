{
  "schemaVersion": 1,
  "kind": "topology-fixture-manifest",
  "contractScope": [
    "strict-json",
    "schema-version",
    "stable-ids",
    "references",
    "grid-bounds",
    "state-geometry",
    "initial-edge-and-opening-occupancy",
    "resource-limits",
    "canonical-bytes-and-checksum"
  ],
  "deferred": [
    "connectivity-policy",
    "tick-and-physics",
    "player-canonical-shape",
    "energy-and-contestation",
    "round-rule"
  ],
  "cases": [

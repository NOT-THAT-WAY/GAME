# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/_GeneratedLocal/
/Assets/_GeneratedLocal.meta

# FishNet régénère seul cette collection en scannant les prefabs NetworkObject du
# projet. Comme les prefabs réseau sont produits dans /Assets/_GeneratedLocal/,
# son contenu diffère d'une machine à l'autre et salirait le dépôt à chaque
# ouverture de Unity. Les scènes générées déclarent leur propre collection.
/Assets/DefaultPrefabObjects.asset
/Assets/DefaultPrefabObjects.asset.meta

# com.unity.test-framework.performance écrit ces fichiers à chaque lancement de
# Unity. Retirer la ligne Resources.meta le jour où le projet versionne un vrai
# asset dans /Assets/Resources/.
/Assets/Resources/PerformanceTestRunInfo.json
/Assets/Resources/PerformanceTestRunInfo.json.meta
/Assets/Resources/PerformanceTestRunSettings.json
/Assets/Resources/PerformanceTestRunSettings.json.meta
/Assets/Resources.meta

# IDEs and editors
.vs/
.idea/
.vscode/
# Unity réécrit .vsconfig au gré des workloads Visual Studio installées sur la
# machine : c'est une préférence locale, pas un contrat partagé.
/.vsconfig
__pycache__/
*.py[cod]
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity crash and profiling output
sysinfo.txt
*.stackdump

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.json
steam_appid.txt
/.dvc/config.local

# Wwise generated/cache data. Authoring sources remain versioned.
/WwiseProject/.cache/
/WwiseProject/.wsettings/
/WwiseProject/GeneratedSoundBanks/
# Nils publie les SoundBanks runtime validées dans
# /Assets/StreamingAssets/Audio/GeneratedSoundBanks/ ; elles sont suivies par LFS.
/Assets/Wwise/GeneratedSoundBanks/
*.akd

# Build and package output
*.apk
*.aab
*.app
*.dmg
*.exe
*.msi
*.pkg
*.unitypackage

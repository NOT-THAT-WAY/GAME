* text=auto eol=lf

*.cs text diff=csharp
*.asmdef text
*.asmref text
*.json text
*.md text
*.meta text eol=lf
*.shader text
*.shadergraph text
*.sh text eol=lf
*.ps1 text eol=crlf

# Unity Smart Merge handles serialized YAML files.
*.anim text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.overrideController text merge=unityyamlmerge eol=lf
*.playable text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.unity text merge=unityyamlmerge eol=lf

# Build-ready binaries may live in Git LFS. Editable masters belong in the
# external DVC vault; these rules remain a safety net against large Git blobs.
*.aif filter=lfs diff=lfs merge=lfs -text lockable
*.aiff filter=lfs diff=lfs merge=lfs -text lockable
*.blend filter=lfs diff=lfs merge=lfs -text lockable
*.exr filter=lfs diff=lfs merge=lfs -text lockable
*.fbx filter=lfs diff=lfs merge=lfs -text lockable
*.flac filter=lfs diff=lfs merge=lfs -text lockable
*.hdr filter=lfs diff=lfs merge=lfs -text lockable
*.kra filter=lfs diff=lfs merge=lfs -text lockable
*.mov filter=lfs diff=lfs merge=lfs -text lockable
*.mp3 filter=lfs diff=lfs merge=lfs -text lockable
*.mp4 filter=lfs diff=lfs merge=lfs -text lockable
*.ogg filter=lfs diff=lfs merge=lfs -text lockable
*.png filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text lockable
*.psd filter=lfs diff=lfs merge=lfs -text lockable
*.tga filter=lfs diff=lfs merge=lfs -text lockable
*.tif filter=lfs diff=lfs merge=lfs -text lockable
*.tiff filter=lfs diff=lfs merge=lfs -text lockable
*.wav filter=lfs diff=lfs merge=lfs -text lockable

# Third-party native binaries are versioned through LFS when permitted.
*.bundle filter=lfs diff=lfs merge=lfs -text
*.bnk filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.pck filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.wem filter=lfs diff=lfs merge=lfs -text

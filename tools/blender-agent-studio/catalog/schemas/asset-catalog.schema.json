{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/blender-team-studio/asset-catalog.schema.json",
  "title": "Blender Team Studio asset catalog",
  "type": "object",
  "required": ["schema_version", "source_label", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "source_label": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "sha256", "bytes", "kind", "paths", "bundled"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["image", "video", "audio", "geometry"]},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "aliases": {"type": "array"},
          "roles": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"},
          "bundled": {"const": false}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

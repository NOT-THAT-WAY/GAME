{
  "id": "scene-spatial-graph",
  "name": "Graphe spatial de scène",
  "icon": "⌘",
  "category": "diagnostic production",
  "mode": "MCP interactif",
  "risk": "lecture",
  "description": "Produit une carte structurelle avec rôles, bounds, parentés, proximité et contacts AABB pour ancrer l'agent dans la scène réelle.",
  "script": "workflows/scripts/scene_spatial_graph.py",
  "timeout": 180,
  "produces_output": true,
  "fields": [
    {
      "id": "collection",
      "type": "text",
      "label": "Collection (vide = scène)",
      "default": ""
    },
    {
      "id": "max_objects",
      "type": "integer",
      "label": "Maximum d'objets",
      "default": 80,
      "min": 1,
      "max": 300
    },
    {
      "id": "relation_distance",
      "type": "number",
      "label": "Distance de proximité",
      "default": 0.25,
      "min": 0,
      "max": 100,
      "step": 0.01
    }
  ],
  "execution": "mcp",
  "mutates_scene": false,
  "requires_confirmation": false,
  "requires_working_copy": false,
  "enabled_in_app": true,
  "save_policy": "never_save_blend_automatically",
  "evidence_level": "diagnostic",
  "domains": [
    "all"
  ],
  "maturity": "stable",
  "scope": "generic-or-adaptable"
}

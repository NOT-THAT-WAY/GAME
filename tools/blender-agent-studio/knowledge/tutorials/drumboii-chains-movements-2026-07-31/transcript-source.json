				"from": "00:04:39,000",
				"to": "00:04:41,000"
			},
			"offsets": {
				"from": 279000,
				"to": 281000
			},
			"text": " Then we are on 10."
		},
		{
			"timestamps": {
				"from": "00:04:41,000",
				"to": "00:04:43,000"
			},
			"offsets": {
				"from": 281000,
				"to": 283000
			},
			"text": " Then we are -10."
		},
		{
			"timestamps": {
				"from": "00:04:43,000",
				"to": "00:04:45,000"
			},
			"offsets": {
				"from": 283000,
				"to": 285000
			},
			"text": " And 10, -10."
		},
		{
			"timestamps": {
				"from": "00:04:45,000",
				"to": "00:04:49,000"
			},
			"offsets": {
				"from": 285000,
				"to": 289000
			},
			"text": " Yeah, so as you can see now, it's just moving around."
		},
		{
			"timestamps": {
				"from": "00:04:49,000",
				"to": "00:04:52,000"
			},
			"offsets": {
				"from": 289000,
				"to": 292000
			},
			"text": " But it looks kind of static, I think."
		},
		{
			"timestamps": {
				"from": "00:04:52,000",
				"to": "00:04:56,000"
			},
			"offsets": {
				"from": 292000,
				"to": 296000
			},
			"text": " Which is why I always use two types of simple deforms."
		},
		{
			"timestamps": {
				"from": "00:04:56,000",
				"to": "00:04:58,000"
			},
			"offsets": {
				"from": 296000,
				"to": 298000
			},
			"text": " So now we are going to add in another one."
		},
		{
			"timestamps": {
				"from": "00:04:58,000",
				"to": "00:05:00,000"
			},
			"offsets": {
				"from": 298000,
				"to": 300000
			},
			"text": " But this time I'm going to use the y-axis."
		},
		{
			"timestamps": {
				"from": "00:05:00,000",
				"to": "00:05:02,000"
			},
			"offsets": {
				"from": 300000,
				"to": 302000
			},
			"text": " And we are going to do the same process."
		},
		{
			"timestamps": {
				"from": "00:05:02,000",
				"to": "00:05:06,000"
			},
			"offsets": {
				"from": 302000,
				"to": 306000
			},
			"text": " But this time I'm going to, on the first frame, use 10 degrees."
		},
		{
			"timestamps": {
				"from": "00:05:06,000",
				"to": "00:05:09,000"
			},
			"offsets": {
				"from": 306000,
				"to": 309000
			},
			"text": " And we can drop it down here so you see."
		},
		{
			"timestamps": {
				"from": "00:05:09,000",
				"to": "00:05:14,000"
			},
			"offsets": {
				"from": 309000,
				"to": 314000
			},
			"text": " And then on frame 50, you can see the first simple deform is on 10."
		},
		{
			"timestamps": {
				"from": "00:05:14,000",
				"to": "00:05:16,000"
			},
			"offsets": {
				"from": 314000,
				"to": 316000
			},
			"text": " But this one will be inverted to -10."
		},
		{
			"timestamps": {
				"from": "00:05:16,000",
				"to": "00:05:21,000"
			},
			"offsets": {
				"from": 316000,
				"to": 321000
			},
			"text": " And then again, 10 here on the second one while this is -10."
		},
		{
			"timestamps": {
				"from": "00:05:21,000",
				"to": "00:05:23,000"
			},
			"offsets": {
				"from": 321000,
				"to": 323000
			},
			"text": " And -10 here while this is 10."
		},
		{
			"timestamps": {
				"from": "00:05:23,000",
				"to": "00:05:26,000"
			},
			"offsets": {
				"from": 323000,
				"to": 326000
			},
			"text": " And then we will just copy this over here like that."
		},
		{
			"timestamps": {
				"from": "00:05:26,000",
				"to": "00:05:30,000"
			},
			"offsets": {
				"from": 326000,
				"to": 330000
			},
			"text": " But now you can see that the animation looks really static and ugly almost."
		},
		{
			"timestamps": {
				"from": "00:05:30,000",
				"to": "00:05:32,000"
			},
			"offsets": {
				"from": 330000,
				"to": 332000
			},
			"text": " And I don't really want that."
		},
		{
			"timestamps": {
				"from": "00:05:32,000",
				"to": "00:05:38,000"
			},
			"offsets": {
				"from": 332000,
				"to": 338000
			},
			"text": " So what I do is that I select, you can see here, the last deform, which is this one we added."
		},
		{
			"timestamps": {
				"from": "00:05:38,000",
				"to": "00:05:40,000"
			},
			"offsets": {
				"from": 338000,
				"to": 340000
			},
			"text": " I'm going to select all these keyframes."
		},
		{
			"timestamps": {
				"from": "00:05:40,000",
				"to": "00:05:45,000"
			},
			"offsets": {
				"from": 340000,
				"to": 345000
			},
			"text": " And then I'm going to move them back around 25."
		},
		{
			"timestamps": {
				"from": "00:05:45,000",
				"to": "00:05:48,000"
			},
			"offsets": {
				"from": 345000,
				"to": 348000
			},
			"text": " So now you can see that they are kind of overlapping."
		},
		{
			"timestamps": {
				"from": "00:05:48,000",
				"to": "00:05:53,000"
			},
			"offsets": {
				"from": 348000,
				"to": 353000
			},
			"text": " Because here are the keyframes for the first simple deform we made."
		},
		{
			"timestamps": {
				"from": "00:05:53,000",
				"to": "00:05:56,000"
			},
			"offsets": {
				"from": 353000,
				"to": 356000
			},
			"text": " And in between them we have the second deform keyframes."
		},
		{
			"timestamps": {
				"from": "00:05:56,000",
				"to": "00:05:59,000"
			},
			"offsets": {
				"from": 356000,
				"to": 359000
			},
			"text": " Which means that they will like be combined and overlap each other."
		},
		{
			"timestamps": {
				"from": "00:05:59,000",
				"to": "00:06:04,000"
			},
			"offsets": {
				"from": 359000,
				"to": 364000
			},
			"text": " And now you can see it looks much smoother."
		},
		{
			"timestamps": {
				"from": "00:06:04,000",
				"to": "00:06:08,000"
			},
			"offsets": {
				"from": 364000,
				"to": 368000
			},
			"text": " But this is pretty much everything I do for my chain animations."
		},
		{
			"timestamps": {
				"from": "00:06:08,000",
				"to": "00:06:11,000"
			},
			"offsets": {
				"from": 368000,
				"to": 371000
			},
			"text": " But there's actually a simpler way to do this."
		},
		{
			"timestamps": {
				"from": "00:06:11,000",
				"to": "00:06:14,000"
			},
			"offsets": {
				"from": 371000,
				"to": 374000
			},
			"text": " So we can get rid of these simple deforms here."
		},
		{
			"timestamps": {
				"from": "00:06:14,000",
				"to": "00:06:16,000"
			},
			"offsets": {
				"from": 374000,
				"to": 376000
			},
			"text": " And now we have nothing again."
		},
		{
			"timestamps": {
				"from": "00:06:16,000",
				"to": "00:06:19,000"
			},
			"offsets": {
				"from": 376000,
				"to": 379000
			},
			"text": " Now we're going to add in just a new simple deform."
		},
		{
			"timestamps": {
				"from": "00:06:19,000",
				"to": "00:06:21,000"
			},
			"offsets": {
				"from": 379000,
				"to": 381000
			},
			"text": " And we're also going to add an empty object."
		},
		{
			"timestamps": {
				"from": "00:06:21,000",
				"to": "00:06:24,000"
			},
			"offsets": {
				"from": 381000,
				"to": 384000
			},
			"text": " So I'm going to press Shift + A and search for plain axis."
		},
		{
			"timestamps": {
				"from": "00:06:24,000",
				"to": "00:06:29,000"
			},
			"offsets": {
				"from": 384000,
				"to": 389000
			},
			"text": " And now we're going to use a driver to animate this axis with."
		},
		{
			"timestamps": {
				"from": "00:06:29,000",
				"to": "00:06:33,000"
			},
			"offsets": {
				"from": 389000,
				"to": 393000
			},
			"text": " And the driver is like you are typing in a constant animation."
		},
		{
			"timestamps": {
				"from": "00:06:33,000",
				"to": "00:06:36,000"
			},
			"offsets": {
				"from": 393000,
				"to": 396000
			},
			"text": " So instead of animating this with keyframes."
		},
		{
			"timestamps": {
				"from": "00:06:36,000",
				"to": "00:06:37,000"
			},
			"offsets": {
				"from": 396000,
				"to": 397000
			},
			"text": " We can type in a number."
		},
		{
			"timestamps": {
				"from": "00:06:37,000",
				"to": "00:06:41,000"
			},
			"offsets": {
				"from": 397000,
				"to": 401000
			},
			"text": " And it will like rotate into infinity."
		},
		{
			"timestamps": {
				"from": "00:06:41,000",
				"to": "00:06:44,000"
			},
			"offsets": {
				"from": 401000,
				"to": 404000
			},
			"text": " So I'm actually going to animate it on the Z axis here."
		},
		{
			"timestamps": {
				"from": "00:06:44,000",
				"to": "00:06:46,000"
			},
			"offsets": {
				"from": 404000,
				"to": 406000
			},
			"text": " To do that you're going to press this."
		},
		{
			"timestamps": {
				"from": "00:06:46,000",
				"to": "00:06:49,000"
			},
			"offsets": {
				"from": 406000,
				"to": 409000
			},
			"text": " And then type in hashtag frame slash."
		},
		{
			"timestamps": {
				"from": "00:06:49,000",
				"to": "00:06:51,000"
			},
			"offsets": {
				"from": 409000,
				"to": 411000
			},
			"text": " And we're going to try 60."
		},
		{
			"timestamps": {
				"from": "00:06:51,000",
				"to": "00:06:54,000"
			},
			"offsets": {
				"from": 411000,
				"to": 414000
			},
			"text": " And you're going to see that it starts rotating."
		},
		{
			"timestamps": {
				"from": "00:06:54,000",
				"to": "00:06:56,000"
			},
			"offsets": {
				"from": 414000,
				"to": 416000
			},
			"text": " But we're not animating it."
		},
		{
			"timestamps": {
				"from": "00:06:56,000",
				"to": "00:06:58,000"
			},
			"offsets": {
				"from": 416000,
				"to": 418000
			},
			"text": " It's driving it automatically."
		},
		{
			"timestamps": {
				"from": "00:06:58,000",
				"to": "00:06:59,000"
			},
			"offsets": {
				"from": 418000,
				"to": 419000
			},
			"text": " The cool thing about this."
		},
		{
			"timestamps": {
				"from": "00:06:59,000",
				"to": "00:07:01,000"
			},
			"offsets": {
				"from": 419000,
				"to": 421000
			},
			"text": " Is that you can now go to the chain."
		},
		{
			"timestamps": {
				"from": "00:07:01,000",
				"to": "00:07:02,000"
			},
			"offsets": {
				"from": 421000,
				"to": 422000
			},
			"text": " And press this drop down."
		},
		{
			"timestamps": {
				"from": "00:07:02,000",
				"to": "00:07:04,000"
			},
			"offsets": {
				"from": 422000,
				"to": 424000
			},
			"text": " And select empty object."
		},
		{
			"timestamps": {
				"from": "00:07:04,000",
				"to": "00:07:06,000"
			},
			"offsets": {
				"from": 424000,
				"to": 426000
			},
			"text": " And if you press space now."
		},
		{
			"timestamps": {
				"from": "00:07:06,000",
				"to": "00:07:09,000"
			},
			"offsets": {
				"from": 426000,
				"to": 429000
			},
			"text": " You will see that it's rotating automatically."
		},
		{
			"timestamps": {
				"from": "00:07:09,000",
				"to": "00:07:11,000"
			},
			"offsets": {
				"from": 429000,
				"to": 431000
			},
			"text": " But you can see that it looks really intense."
		},
		{
			"timestamps": {
				"from": "00:07:11,000",
				"to": "00:07:13,000"
			},
			"offsets": {
				"from": 431000,
				"to": 433000
			},
			"text": " So you might want to turn down the angle here."
		},
		{
			"timestamps": {
				"from": "00:07:13,000",
				"to": "00:07:15,000"
			},
			"offsets": {
				"from": 433000,
				"to": 435000
			},
			"text": " To maybe something like 10."
		},
		{
			"timestamps": {
				"from": "00:07:15,000",
				"to": "00:07:18,000"
			},
			"offsets": {
				"from": 435000,
				"to": 438000
			},
			"text": " So yeah just a subtle little animation."
		},
		{
			"timestamps": {
				"from": "00:07:18,000",
				"to": "00:07:21,000"
			},
			"offsets": {
				"from": 438000,
				"to": 441000
			},
			"text": " And you can play around with the placement of this."
		},
		{
			"timestamps": {
				"from": "00:07:21,000",
				"to": "00:07:23,000"
			},
			"offsets": {
				"from": 441000,
				"to": 443000
			},
			"text": " Which will affect how the rotation is."
		},
		{
			"timestamps": {
				"from": "00:07:23,000",
				"to": "00:07:27,000"
			},
			"offsets": {
				"from": 443000,
				"to": 447000
			},
			"text": " Depending on both of its origin points."
		},
		{
			"timestamps": {
				"from": "00:07:27,000",
				"to": "00:07:29,000"
			},
			"offsets": {
				"from": 447000,
				"to": 449000
			},
			"text": " But yeah that's pretty much everything I do."
		},
		{
			"timestamps": {
				"from": "00:07:29,000",
				"to": "00:07:30,000"
			},
			"offsets": {
				"from": 449000,
				"to": 450000
			},
			"text": " For my chain animations."
		},
		{
			"timestamps": {
				"from": "00:07:30,000",
				"to": "00:07:32,000"
			},
			"offsets": {
				"from": 450000,
				"to": 452000
			},
			"text": " Let me know if you wonder anything down below."
		},
		{
			"timestamps": {
				"from": "00:07:32,000",
				"to": "00:07:34,000"
			},
			"offsets": {
				"from": 452000,
				"to": 454000
			},
			"text": " And I'll see you in the next video."
		}
	]
}

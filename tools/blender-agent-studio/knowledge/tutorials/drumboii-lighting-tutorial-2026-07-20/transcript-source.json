				"to": "00:00:12,000"
			},
			"offsets": {
				"from": 8000,
				"to": 12000
			},
			"text": " And I'm going to use one of my scenes from one of my videos here."
		},
		{
			"timestamps": {
				"from": "00:00:12,000",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 12000,
				"to": 20000
			},
			"text": " And I'm going to walk you through the process of how I set up my different types of lightning to achieve what I think is a satisfying look."
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:24,000"
			},
			"offsets": {
				"from": 20000,
				"to": 24000
			},
			"text": " So a bit quick here, I use Cycles."
		},
		{
			"timestamps": {
				"from": "00:00:24,000",
				"to": "00:00:29,000"
			},
			"offsets": {
				"from": 24000,
				"to": 29000
			},
			"text": " So right now I have zero lights on, so you can't see anything."
